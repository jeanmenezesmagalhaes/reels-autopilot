# Vercel adds DATABASE_URL and BLOB_READ_WRITE_TOKEN when you connect Neon and Blob.
# Pull them locally with: npx vercel env pull .env.local
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Instagram API with Instagram Login (set these in Vercel yourself)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRADUATION_STRATEGY=MANUAL
IG_API_VERSION=v23.0
POSTS_PER_DAY=2

# Random strings, e.g. `openssl rand -hex 32`
CRON_SECRET=
PIPELINE_SECRET=
DASHBOARD_PASSWORD=

# Local pipeline only
APP_URL=https://reels-autopilot.vercel.app
REELS_DIR=
