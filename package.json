{
  "name": "reels-autopilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pipeline:upload": "tsx --env-file=.env.local pipeline/upload.mts",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "pipeline:report": "tsx --env-file=.env.local pipeline/report.mts",
    "pipeline:run": "tsx --env-file=.env.local pipeline/run.mts",
    "setup:google": "tsx scripts/setup-google-login.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "zod": "$zod",
    "postcss": "^8.5.31"
  }
}
